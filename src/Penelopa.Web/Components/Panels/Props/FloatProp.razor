@namespace Penelopa.Web.Components.Panels.Props
@using System.Globalization
@using Penelopa.Core.Primitives
@inherits PropEditorBase

<div class="penelopa-prop-field">
    <label class="penelopa-prop-label" for="@FieldId">@PropValue.Name</label>
    <input id="@FieldId"
           type="number"
           step="any"
           class="penelopa-prop-input @(Error is null ? string.Empty : "is-invalid")"
           value="@Text"
           placeholder="@ConflictPlaceholder"
           aria-invalid="@(Error is null ? null : "true")"
           aria-describedby="@(Error is null ? null : ErrorId)"
           @oninput="OnInput"
           @onchange="OnChange" />
    @if (Error is not null)
    {
        <div id="@ErrorId" class="penelopa-prop-error" role="alert">@Error</div>
    }
</div>

@code {
    protected override string Format(PropValue property)
        => ((FloatPropValue)property).Value.ToString(CultureInfo.InvariantCulture);
}
