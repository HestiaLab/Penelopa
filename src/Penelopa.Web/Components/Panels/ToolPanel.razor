@namespace Penelopa.Web.Components
@using Atlas.Blazor.Content
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Penelopa.Core.Alignment
@using Penelopa.Core.Primitives
@using Penelopa.Core.Services
@using Penelopa.Core.Simulation
@using Penelopa.Web.Services
@inherits AtlasContentComponent
@implements IDisposable

<div class="penelopa-tools">
    <div class="penelopa-tool-section">
        <h2 class="penelopa-tool-label">Add</h2>
        <div class="penelopa-tool-actions">
            <button type="button" class="penelopa-action" @onclick="() => Add(() => new Circle())">
                <PenelopaIcon Name="circle" Size="14" />
                <span>Circle</span>
            </button>
            <button type="button" class="penelopa-action" @onclick="() => Add(() => new Rectangle())">
                <PenelopaIcon Name="square" Size="14" />
                <span>Rectangle</span>
            </button>
            <button type="button" class="penelopa-action" @onclick="() => Add(() => new Triangle())">
                <PenelopaIcon Name="triangle" Size="14" />
                <span>Triangle</span>
            </button>
        </div>
        <p class="penelopa-tool-hint">Adds into the selected container when one is selected.</p>
    </div>

    <div class="penelopa-tool-section">
        <h2 class="penelopa-tool-label">Container</h2>
        <div class="penelopa-tool-actions">
            <button type="button" class="penelopa-action" @onclick="AddOffsetContainer">
                <PenelopaIcon Name="move" Size="14" />
                <span>Offset</span>
            </button>
            <button type="button" class="penelopa-action" @onclick="AddRotationContainer">
                <PenelopaIcon Name="rotate" Size="14" />
                <span>Rotate</span>
            </button>
            <button type="button" class="penelopa-action" @onclick="AddFlipContainer">
                <PenelopaIcon Name="flip" Size="14" />
                <span>Flip</span>
            </button>
        </div>
    </div>

    <div class="penelopa-tool-section">
        <h2 class="penelopa-tool-label">Document</h2>
        <div class="penelopa-tool-actions">
            <button type="button"
                    class="penelopa-action"
                    disabled="@(_isSaving || _isLoading || _isImporting || _isExporting || _pendingOperation == PendingOperation.SaveDormant)"
                    @onclick="SaveDocument">
                <PenelopaIcon Name="save" Size="14" />
                <span>Save</span>
            </button>
            <button type="button"
                    class="penelopa-action"
                    disabled="@(_isSaving || _isLoading || _isImporting || _isExporting)"
                    @onclick="LoadDocument">
                <PenelopaIcon Name="folder-open" Size="14" />
                <span>Load</span>
            </button>
            <label id="penelopa-import-file-control"
                   class="penelopa-action penelopa-file-button @(ImportDisabled ? "is-disabled" : string.Empty)"
                   aria-disabled="@(ImportDisabled ? "true" : "false")">
                <PenelopaIcon Name="upload" Size="14" />
                <span>@(_isImporting ? "Importing…" : "Import file…")</span>
                <InputFile accept=".json,application/json"
                           disabled="@ImportDisabled"
                           OnChange="OnImportFileSelected"
                           aria-describedby="penelopa-document-file-hint" />
            </label>
            <button type="button"
                    class="penelopa-action"
                    disabled="@(_isSaving || _isLoading || _isImporting || _isExporting)"
                    @onclick="ExportDocumentAsync">
                <PenelopaIcon Name="download" Size="14" />
                <span>@(_isExporting ? "Exporting…" : "Export file…")</span>
            </button>
        </div>
        <p class="penelopa-tool-hint" id="penelopa-document-file-hint">
            Save/Load use this browser. Import/Export use a .penelopa.json file.
        </p>
        @if (_pendingOperation == PendingOperation.ImportConfirm && _pendingImport?.Document is not null)
        {
            <div class="penelopa-tool-confirm" role="group" aria-label="Import confirmation">
                <p class="penelopa-tool-hint">
                    Replace the current document and simulation configuration with
                    <strong>@_pendingImport.FileName</strong>? You can undo this import
                    until you edit, save, load, or import again.
                </p>
                <p class="penelopa-tool-hint">
                    @PendingImportPrimitiveCount primitive(s), @PendingImportTrackCount active track(s).
                </p>
                <p class="penelopa-visually-hidden" role="status">
                    @PendingImportPrimitiveCount primitive(s), @PendingImportTrackCount active track(s), @PendingImportWarningCount warning(s). Confirm or cancel.
                </p>
                @if (_pendingImport.Document.Warnings.Count > 0)
                {
                    <ul class="penelopa-tool-warning-list">
                        @foreach (var warning in _pendingImport.Document.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                }
                <div class="penelopa-tool-actions">
                    <button type="button"
                            class="penelopa-action is-primary"
                            @ref="_replaceDocumentButton"
                            @onclick="ConfirmImport">Replace document</button>
                    <button type="button" class="penelopa-action" @onclick="CancelImport">Cancel import</button>
                </div>
            </div>
        }
        @if (_pendingOperation == PendingOperation.LoadConfirm && _pendingLoad is not null)
        {
            <div class="penelopa-tool-confirm">
                <p class="penelopa-tool-hint">
                    Replace the current document and simulation configuration with the saved one?
                </p>
                <div class="penelopa-tool-actions">
                    <button type="button" class="penelopa-action is-primary" @onclick="ConfirmLoad">Replace</button>
                    <button type="button" class="penelopa-action" @onclick="CancelLoad">Cancel</button>
                </div>
            </div>
        }
        @if (_pendingOperation == PendingOperation.SaveDormant && _pendingSave is not null)
        {
            <div class="penelopa-tool-confirm">
                <p class="penelopa-tool-hint">
                    @_pendingDormantCount simulation track(s) reference deleted primitives
                    and will not be saved. Save the remaining document and active tracks?
                </p>
                <div class="penelopa-tool-actions">
                    <button type="button"
                            class="penelopa-action is-primary"
                            disabled="@_isSaving"
                            @onclick="ConfirmDormantSave">Save active only</button>
                    <button type="button"
                            class="penelopa-action"
                            disabled="@_isSaving"
                            @onclick="CancelDormantSave">Cancel save</button>
                </div>
            </div>
        }
        @if (_pendingOperation == PendingOperation.ExportDormant)
        {
            <div class="penelopa-tool-confirm">
                <p class="penelopa-tool-hint">
                    @_pendingDormantCount simulation track(s) reference deleted primitives
                    and will not be exported. Export the remaining document and active tracks?
                </p>
                <div class="penelopa-tool-actions">
                    <button type="button"
                            class="penelopa-action is-primary"
                            disabled="@_isExporting"
                            @onclick="ConfirmDormantExportAsync">Export active only</button>
                    <button type="button"
                            class="penelopa-action"
                            disabled="@_isExporting"
                            @onclick="CancelDormantExport">Cancel export</button>
                </div>
            </div>
        }
        @if (ImportRollback.CanUndo)
        {
            <div class="penelopa-tool-confirm penelopa-import-undo"
                 role="group"
                 aria-label="Import rollback">
                <p class="penelopa-tool-hint" role="status">
                    Imported <strong>@ImportRollback.ImportedFileName</strong>. Undo import
                    restores the previous document, selection, and both undo histories.
                </p>
                <div class="penelopa-tool-actions">
                    <button type="button"
                            class="penelopa-action"
                            disabled="@(!CanUndoImport)"
                            @onclick="UndoImport">Undo import</button>
                </div>
            </div>
        }
        @if (_documentMessage is not null)
        {
            <p class="penelopa-tool-message @GetMessageClass()"
               role="@(_documentError ? "alert" : "status")"
               aria-live="@(_documentError ? "assertive" : "polite")"
               tabindex="-1"
               @ref="_documentMessageElement">@_documentMessage</p>
        }
    </div>

    <div class="penelopa-tool-section">
        <h2 class="penelopa-tool-label">Align</h2>
        <div class="penelopa-tool-actions is-align">
            <button type="button" class="penelopa-action" @onclick="() => Align(AlignType.Left)">&#8592; Left</button>
            <button type="button" class="penelopa-action" @onclick="() => Align(AlignType.HCenter)">&#8596; H-Center</button>
            <button type="button" class="penelopa-action" @onclick="() => Align(AlignType.Right)">&#8594; Right</button>
            <button type="button" class="penelopa-action" @onclick="() => Align(AlignType.Top)">&#8593; Top</button>
            <button type="button" class="penelopa-action" @onclick="() => Align(AlignType.VCenter)">&#8597; V-Center</button>
            <button type="button" class="penelopa-action" @onclick="() => Align(AlignType.Bottom)">&#8595; Bottom</button>
        </div>
    </div>

    <div class="penelopa-tool-section">
        <h2 class="penelopa-tool-label">Selection</h2>
        <div class="penelopa-tool-actions">
            <button type="button"
                    class="penelopa-action"
                    aria-keyshortcuts="Delete"
                    disabled="@(!_hasSelection)"
                    @onclick="DeleteSelection">
                <PenelopaIcon Name="trash" Size="14" />
                <span>Delete</span>
            </button>
        </div>
        <p class="penelopa-tool-hint">Deletes the selected primitives. Undo with Ctrl+Z.</p>
    </div>

    <div class="penelopa-tool-section">
        <h2 class="penelopa-tool-label">Group</h2>
        <div class="penelopa-tool-actions">
            <button type="button"
                    class="penelopa-action"
                    aria-describedby="penelopa-group-hint"
                    disabled="@(!_canGroup)"
                    @onclick="GroupSelection">
                <PenelopaIcon Name="group" Size="14" />
                <span>Group</span>
            </button>
            <button type="button"
                    class="penelopa-action"
                    aria-describedby="penelopa-group-hint"
                    disabled="@(!_canUngroup)"
                    @onclick="UngroupSelection">
                <PenelopaIcon Name="ungroup" Size="14" />
                <span>Ungroup</span>
            </button>
        </div>
        <p class="penelopa-tool-hint" id="penelopa-group-hint">
            Group two or more root primitives. Ungroup a root container with an identity
            transform (offset 0, rotation 0, scale 1).
        </p>
        @if (_groupMessage is not null)
        {
            <p class="penelopa-tool-message is-error">@_groupMessage</p>
        }
    </div>
</div>

@code {
    private DeserializeResult? _pendingLoad;
    private DocumentFileLoadResult? _pendingImport;
    private SimulationConfig? _pendingSave;
    private int _pendingDormantCount;
    private PendingOperation _pendingOperation;
    private bool _isSaving;
    private bool _isLoading;
    private bool _isImporting;
    private bool _isExporting;
    private string? _documentMessage;
    private bool _documentError;
    private bool _documentWarning;
    private bool _hasSelection;
    private bool _canGroup;
    private bool _canUngroup;
    private string? _groupMessage;
    private bool _disposed;
    private bool _focusImportConfirmation;
    private bool _focusDocumentMessage;
    private ElementReference _replaceDocumentButton;
    private ElementReference _documentMessageElement;

    private bool ImportDisabled
        => _isSaving || _isLoading || _isImporting || _isExporting;

    private int PendingImportPrimitiveCount
        => _pendingImport?.Document is { } document
            ? DocumentFileService.CountPrimitives(document.Roots)
            : 0;

    private int PendingImportTrackCount
        => _pendingImport?.Document?.Simulation?.Tracks.Count ?? 0;

    private int PendingImportWarningCount
        => _pendingImport?.Document?.Warnings.Count ?? 0;

    private bool CanUndoImport
        => ImportRollback.CanUndo
            && !_isSaving
            && !_isLoading
            && !_isImporting
            && !_isExporting
            && _pendingOperation == PendingOperation.None;

    private enum PendingOperation
    {
        None,
        SaveDormant,
        LoadConfirm,
        ImportConfirm,
        ExportDormant,
    }

    [Inject]
    private IPrimitiveService PrimitiveService { get; set; } = null!;

    [Inject]
    private SimulationConfigStore SimulationConfigStore { get; set; } = null!;

    [Inject]
    private DocumentStorage DocumentStorage { get; set; } = null!;

    [Inject]
    private DocumentFileService DocumentFiles { get; set; } = null!;

    [Inject]
    private DocumentImportRollbackService ImportRollback { get; set; } = null!;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdateSelectionState(PrimitiveService.GetSelection());
        PrimitiveService.Changed += HandleDocumentChanged;
        SimulationConfigStore.Changed += HandleSimulationConfigChanged;
        ImportRollback.Changed += HandleImportRollbackChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusImportConfirmation)
        {
            _focusImportConfirmation = false;
            await FocusAsync(
                _replaceDocumentButton,
                "import confirmation");
        }

        if (_focusDocumentMessage)
        {
            _focusDocumentMessage = false;
            await FocusAsync(
                _documentMessageElement,
                "document message");
        }
    }

    private static async Task FocusAsync(ElementReference element, string target)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException
            or JSDisconnectedException
            or InvalidOperationException)
        {
            // 焦点是增强；JS 不可达时保留消息与键盘顺序。
            Console.Error.WriteLine(
                $"[Penelopa] ToolPanel {target} focus failed: {ex}");
        }
    }

    private void HandleDocumentChanged(DocumentChange change)
    {
        var contentChanged = (change.Kind
            & (DocumentChangeKind.Structure | DocumentChangeKind.Geometry)) != 0;
        if (contentChanged
            && _pendingOperation is (PendingOperation.ImportConfirm or PendingOperation.ExportDormant))
        {
            var canceled = _pendingOperation == PendingOperation.ImportConfirm
                ? "Import canceled because the document changed. Select the file again."
                : "Export canceled because the document changed. Try again.";
            ClearPendingOperation();
            SetDocumentMessage(canceled, error: false, warning: true);
        }

        UpdateSelectionState(change.State.Selection);
        _groupMessage = null;
        if (_pendingOperation == PendingOperation.SaveDormant)
        {
            // 确认期间文档可能变化（删除/撤销/加载前编辑）；重新计算，避免保存旧配置快照。
            var active = SimulationConfigStore.ExportActive();
            var dormant = SimulationConfigStore.Config.Tracks.Count - active.Tracks.Count;
            if (dormant == 0)
            {
                ClearPendingOperation();
            }
            else
            {
                _pendingSave = active;
                _pendingDormantCount = dormant;
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// 配置变更也意味着待确认的导入/导出不再对应同一状态；选中项和播放不受影响，
    /// 因此只在持久配置变化时取消。
    /// </summary>
    private void HandleSimulationConfigChanged()
    {
        if (_pendingOperation is not (PendingOperation.ImportConfirm or PendingOperation.ExportDormant))
        {
            return;
        }

        var canceled = _pendingOperation == PendingOperation.ImportConfirm
            ? "Import canceled because the simulation configuration changed. Select the file again."
            : "Export canceled because the simulation configuration changed. Try again.";
        ClearPendingOperation();
        SetDocumentMessage(canceled, error: false, warning: true);
        StateHasChanged();
    }

    private void UpdateSelectionState(IReadOnlyList<Primitive> selection)
    {
        _hasSelection = selection.Count > 0;
        _canGroup = selection.Count >= 2 && selection.All(primitive => primitive.Parent is null);
        _canUngroup = selection.Count == 1
            && selection[0] is Container container
            && container.Parent is null
            && container.LocalTransform.IsIdentity;
    }

    private void DeleteSelection()
    {
        PrimitiveService.RemoveRange(PrimitiveService.GetSelection());
    }

    private void GroupSelection()
    {
        _ = PrimitiveService.GroupSelection(out var error);
        _groupMessage = error;
    }

    private void UngroupSelection()
    {
        var selection = PrimitiveService.GetSelection();
        if (selection.Count != 1 || selection[0] is not Container container)
        {
            _groupMessage = "Select one root container to ungroup.";
            return;
        }

        _ = PrimitiveService.TryUngroup(container, out var error);
        _groupMessage = error;
    }

    private void HandleImportRollbackChanged()
        => StateHasChanged();

    public void Dispose()
    {
        _disposed = true;
        PrimitiveService.Changed -= HandleDocumentChanged;
        SimulationConfigStore.Changed -= HandleSimulationConfigChanged;
        ImportRollback.Changed -= HandleImportRollbackChanged;
    }

    private void Add(Func<Primitive> factory)
    {
        var primitive = factory();
        var selection = PrimitiveService.GetSelection().ToList();
        var container = selection.Count == 1 ? selection[0] as Container : null;
        if (container is not null)
        {
            PrimitiveService.AddToContainer(container, primitive);
        }
        else
        {
            PrimitiveService.Add(primitive);
        }
    }

    private void AddContainer(Container container)
    {
        PrimitiveService.Add(container);
        PrimitiveService.SetSelected(container);
    }

    private void AddOffsetContainer()
        => AddContainer(Container.CreateOffset("Offset Container", 20f, 20f));

    private void AddRotationContainer()
        => AddContainer(Container.CreateRotation("Rotate Container", 45f));

    private void AddFlipContainer()
        => AddContainer(Container.CreateFlip("Flip Container", flipX: true, flipY: false));

    private void Align(AlignType type)
    {
        // 服务层事务边界统一处理对齐/通知/撤销，已对齐时不产生历史条目
        PrimitiveService.Align(type);
    }

    private async Task SaveDocument()
    {
        if (_isSaving || _isLoading || _isImporting || _isExporting)
        {
            return;
        }

        // Save 与 Load 的确认互斥；开始新的保存即放弃未确认的加载。
        ClearPendingOperation();

        var active = SimulationConfigStore.ExportActive();
        var dormant = SimulationConfigStore.Config.Tracks.Count - active.Tracks.Count;
        if (dormant > 0)
        {
            _pendingSave = active;
            _pendingDormantCount = dormant;
            _pendingOperation = PendingOperation.SaveDormant;
            SetDocumentMessage(null, error: false);
            return;
        }

        await SaveDocumentCore(active);
    }

    private async Task ConfirmDormantSave()
    {
        if (_pendingOperation != PendingOperation.SaveDormant || _isSaving)
        {
            return;
        }

        // 绝不复用确认时的快照：文档或配置可能已变化。
        var active = SimulationConfigStore.ExportActive();
        var dormant = SimulationConfigStore.Config.Tracks.Count - active.Tracks.Count;
        if (dormant > 0 && dormant != _pendingDormantCount)
        {
            _pendingSave = active;
            _pendingDormantCount = dormant;
            StateHasChanged();
            return;
        }

        await SaveDocumentCore(active);
    }

    private void CancelDormantSave()
    {
        if (_isSaving)
        {
            return;
        }

        ClearPendingOperation();
        SetDocumentMessage(null, error: false);
    }

    private async Task SaveDocumentCore(SimulationConfig active)
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        ClearPendingOperation();
        StateHasChanged();
        try
        {
            var result = await DocumentStorage.SaveAsync(
                PrimitiveService.GetAll().ToList(),
                PrimitiveService.GetSelection().ToList(),
                active);
            if (!result.Success)
            {
                SetDocumentMessage(
                    result.Error ?? "The document could not be saved.",
                    error: true);
                return;
            }

            SetDocumentMessage("Document saved.", error: false);
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>读取并校验文档；通过后进入确认步骤，不立即覆盖当前文档。</summary>
    private async Task LoadDocument()
    {
        if (_isLoading || _isSaving || _isImporting || _isExporting)
        {
            return;
        }

        // 加载开始即取消未确认的 Dormant 保存，禁止旧快照跨文档存活。
        _isLoading = true;
        ClearPendingOperation();
        StateHasChanged();
        try
        {
            var result = await DocumentStorage.LoadAsync();
            if (result.Document is null)
            {
                SetDocumentMessage(
                    result.Error ?? "The saved document is invalid or unsupported.",
                    error: true);
                return;
            }

            _pendingLoad = result.Document;
            _pendingOperation = PendingOperation.LoadConfirm;
            SetDocumentMessage(null, error: false);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ConfirmLoad()
    {
        if (_pendingOperation != PendingOperation.LoadConfirm
            || _pendingLoad is null
            || _isLoading)
        {
            return;
        }

        var result = _pendingLoad;
        ClearPendingOperation();

        // Deserialize 已保证 Id 唯一；ResolveSelection 会忽略未知 Id
        var selected = result.ResolveSelection();
        PrimitiveService.ReplaceAll(result.Roots);
        // 即使选区为空也显式通知，属性面板必须清空而非保留旧目标
        PrimitiveService.SetSelectedRange(selected);
        SimulationConfigStore.ReplaceConfig(
            result.Simulation ?? SimulationConfig.Empty);

        if (result.Warnings.Count > 0)
        {
            SetDocumentMessage(
                "Document loaded. " + string.Join(" ", result.Warnings),
                error: false,
                warning: true);
        }
        else
        {
            SetDocumentMessage("Document loaded.", error: false);
        }
    }

    private void CancelLoad()
    {
        if (_isLoading)
        {
            return;
        }

        ClearPendingOperation();
        SetDocumentMessage(null, error: false);
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs args)
    {
        try
        {
            if (ImportDisabled)
            {
                return;
            }

            ClearPendingOperation();
            SetDocumentMessage(null, error: false);

            if (args.FileCount == 0)
            {
                return;
            }

            if (args.FileCount != 1)
            {
                SetDocumentMessage("Choose one file at a time.", error: true);
                return;
            }

            _isImporting = true;
            StateHasChanged();
            var result = await DocumentFiles.ReadAsync(args.File);
            if (!result.Success)
            {
                SetDocumentMessage(
                    result.Error ?? "The selected file is not a valid Penelopa document.",
                    error: true);
                return;
            }

            _pendingImport = result;
            _pendingOperation = PendingOperation.ImportConfirm;
            _focusImportConfirmation = true;
        }
        catch (Exception ex)
        {
            // 文件流来自浏览器互操作；边界处只暴露可操作的一行错误。
            Console.Error.WriteLine($"[Penelopa] ToolPanel import failed: {ex}");
            SetDocumentMessage("The file could not be read.", error: true);
        }
        finally
        {
            // 读取完成后才能清空 input，否则会提前丢掉正在读取的文件引用。
            _isImporting = false;
            if (!_disposed)
            {
                await ResetImportInputAsync();
                StateHasChanged();
            }
        }
    }

    /// <summary>允许用户再次选择同一个文件；失败只记录日志，不破坏导入结果。</summary>
    private async Task ResetImportInputAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "penelopa.resetFileInput",
                "#penelopa-import-file-control");
        }
        catch (Exception ex) when (ex is JSException
            or JSDisconnectedException
            or InvalidOperationException)
        {
            Console.Error.WriteLine(
                $"[Penelopa] ToolPanel import input reset failed: {ex}");
        }
    }

    private void ConfirmImport()
    {
        if (_pendingOperation != PendingOperation.ImportConfirm
            || _pendingImport?.Document is not { } document
            || _isImporting)
        {
            return;
        }

        var pending = _pendingImport;
        ClearPendingOperation();
        if (!ImportRollback.TryApplyImport(
            pending.FileName,
            () => DocumentFiles.Apply(document),
            out var error))
        {
            SetDocumentMessage(error ?? "The document could not be imported.", error: true);
            return;
        }

        if (document.Warnings.Count > 0)
        {
            SetDocumentMessage(
                "Imported with warnings: " + string.Join(" ", document.Warnings),
                error: false,
                warning: true);
        }
        else
        {
            SetDocumentMessage("Document imported.", error: false);
        }

        // 焦点从被移除的确认块移到状态横幅，既播报成功也保留下一步 Tab 顺序。
        _focusDocumentMessage = true;
        StateHasChanged();
    }

    private void CancelImport()
    {
        if (_isImporting)
        {
            return;
        }

        ClearPendingOperation();
        SetDocumentMessage("Import canceled.", error: false);
    }

    private void UndoImport()
    {
        if (!CanUndoImport)
        {
            return;
        }

        try
        {
            if (!ImportRollback.UndoImport())
            {
                SetDocumentMessage("There is no import to undo.", error: true);
                return;
            }

            SetDocumentMessage("Import undone.", error: false);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Penelopa] ToolPanel import undo failed: {ex}");
            SetDocumentMessage("The import could not be undone.", error: true);
        }
    }

    private async Task ExportDocumentAsync()
    {
        if (_isSaving || _isLoading || _isImporting || _isExporting)
        {
            return;
        }

        ClearPendingOperation();
        SetDocumentMessage(null, error: false);
        var dormant = CountDormantTracks();
        if (dormant > 0)
        {
            _pendingDormantCount = dormant;
            _pendingOperation = PendingOperation.ExportDormant;
            StateHasChanged();
            return;
        }

        await ExportDocumentCoreAsync();
    }

    private async Task ConfirmDormantExportAsync()
    {
        if (_pendingOperation != PendingOperation.ExportDormant || _isExporting)
        {
            return;
        }

        var dormant = CountDormantTracks();
        if (dormant > 0 && dormant != _pendingDormantCount)
        {
            _pendingDormantCount = dormant;
            StateHasChanged();
            return;
        }

        await ExportDocumentCoreAsync();
    }

    private void CancelDormantExport()
    {
        if (_isExporting)
        {
            return;
        }

        ClearPendingOperation();
        SetDocumentMessage(null, error: false);
    }

    private async Task ExportDocumentCoreAsync()
    {
        if (_isExporting)
        {
            return;
        }

        var dormant = CountDormantTracks();
        _isExporting = true;
        ClearPendingOperation();
        StateHasChanged();
        try
        {
            var payload = DocumentFiles.CreateExport();
            await JS.InvokeVoidAsync(
                "penelopa.downloadTextFile",
                payload.FileName,
                payload.Json);
            SetDocumentMessage(
                dormant > 0
                    ? $"Document exported; {dormant} inactive track(s) were excluded."
                    : "Document exported.",
                error: false,
                warning: dormant > 0);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Penelopa] ToolPanel export failed: {ex}");
            SetDocumentMessage("The document could not be exported.", error: true);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private int CountDormantTracks()
    {
        var active = SimulationConfigStore.ExportActive();
        return SimulationConfigStore.Config.Tracks.Count - active.Tracks.Count;
    }

    private void ClearPendingOperation()
    {
        _pendingLoad = null;
        _pendingImport = null;
        _pendingSave = null;
        _pendingDormantCount = 0;
        _pendingOperation = PendingOperation.None;
    }

    private void SetDocumentMessage(
        string? message,
        bool error,
        bool warning = false)
    {
        _documentMessage = message;
        _documentError = error;
        _documentWarning = warning;
    }

    private string GetMessageClass()
    {
        if (_documentError)
        {
            return "is-error";
        }

        return _documentWarning ? "is-warning" : string.Empty;
    }
}
