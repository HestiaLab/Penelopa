@namespace Penelopa.Web.Components
@using Atlas.Blazor.Content
@using Penelopa.Core.Primitives
@using Penelopa.Core.Services
@using DocumentState = Penelopa.Core.Services.DocumentState
@using Penelopa.Web.Components.Panels.Props
@inherits AtlasContentComponent
@implements IDisposable

<div class="penelopa-properties">
    @if (_targets.Count == 0)
    {
        <p class="penelopa-properties-empty">Select a primitive to view its properties.</p>
    }
    else
    {
        <div class="penelopa-properties-title">
            @(_targets.Count == 1 ? _targets[0].Name.Value : $"{_targets.Count} primitives selected")
        </div>
        @if (_targets.Count > 1)
        {
            <p class="penelopa-properties-hint">
                Editing the properties shared by the whole selection. Fields showing
                &ldquo;Multiple values&rdquo; write one value to every primitive.
            </p>
        }
        @foreach (var prop in _commonProps)
        {
            <div class="penelopa-properties-item" @key="prop">
                @switch (prop)
                {
                    case FloatPropValue fpv:
                        <FloatProp Owners="_targets" PropValue="fpv" />
                        break;
                    case DoublePropValue dpv:
                        <DoubleProp Owners="_targets" PropValue="dpv" />
                        break;
                    case IntPropValue ipv:
                        <IntProp Owners="_targets" PropValue="ipv" />
                        break;
                    case BoolPropValue bpv:
                        <BoolProp Owners="_targets" PropValue="bpv" />
                        break;
                    case UintPropValue upv:
                        <UintProp Owners="_targets" PropValue="upv" />
                        break;
                    case StringPropValue spv:
                        <StringProp Owners="_targets" PropValue="spv" />
                        break;
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<Primitive> _targets = Array.Empty<Primitive>();
    private IReadOnlyList<PropValue> _commonProps = Array.Empty<PropValue>();

    [Inject]
    private IPrimitiveService PrimitiveService { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ApplyState(PrimitiveService.GetState());
        PrimitiveService.Changed += HandleDocumentChanged;
    }

    private void HandleDocumentChanged(DocumentChange change)
    {
        ApplyState(change.State);
        StateHasChanged();
    }

    /// <summary>目标与可编辑属性始终由当前快照派生，不保留已不存在的图元或陈旧值。</summary>
    private void ApplyState(DocumentState state)
    {
        _targets = state.Selection.ToArray();
        _commonProps = FindCommonProperties(_targets);
    }

    /// <summary>
    /// 多选时只显示名称与类型都一致的属性；单选时显示全部属性。
    /// 避免把只存在于部分图元上的字段当作可安全批量写入的公共字段。
    /// </summary>
    private static IReadOnlyList<PropValue> FindCommonProperties(IReadOnlyList<Primitive> targets)
    {
        if (targets.Count == 0)
        {
            return Array.Empty<PropValue>();
        }

        if (targets.Count == 1)
        {
            return targets[0].Props.ToArray();
        }

        var common = new List<PropValue>();
        foreach (var candidate in targets[0].Props)
        {
            var shared = true;
            for (var index = 1; index < targets.Count; index++)
            {
                var match = targets[index].Props.Any(property =>
                    string.Equals(property.Name, candidate.Name, StringComparison.Ordinal)
                    && property.GetType() == candidate.GetType());
                if (!match)
                {
                    shared = false;
                    break;
                }
            }

            if (shared)
            {
                common.Add(candidate);
            }
        }

        return common;
    }

    public void Dispose()
    {
        PrimitiveService.Changed -= HandleDocumentChanged;
    }
}
