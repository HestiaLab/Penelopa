@namespace Penelopa.Web.Components.Simulation
@using System.Globalization
@using Penelopa.Core.Simulation
@using Penelopa.Web.Services
@implements IDisposable

<input type="range"
       class="penelopa-simulation-scrubber"
       min="0"
       max="@Invariant(Duration)"
       step="0.001"
       value="@Invariant(CurrentTime())"
       aria-label="Simulation playhead"
       @oninput="OnScrub" />

@code {
    private SimulationReadout? _readout;
    private SimulationReadoutChannel? _subscribedChannel;
    private bool _disposed;

    [Parameter, EditorRequired]
    public SimulationReadoutChannel Channel { get; set; } = null!;

    [Parameter]
    public double Duration { get; set; }

    [Parameter]
    public EventCallback<double> OnSeekRequested { get; set; }

    protected override void OnParametersSet()
    {
        Subscribe();
        _readout = Channel.Current ?? _readout;
    }

    private void Subscribe()
    {
        if (ReferenceEquals(_subscribedChannel, Channel))
        {
            return;
        }

        if (_subscribedChannel is not null)
        {
            _subscribedChannel.Updated -= HandleReadout;
        }

        _subscribedChannel = Channel;
        if (_subscribedChannel is not null)
        {
            _subscribedChannel.Updated += HandleReadout;
        }
    }

    private void HandleReadout(SimulationReadout readout)
    {
        if (_disposed)
        {
            return;
        }

        _readout = readout;
        _ = InvokeAsync(StateHasChanged);
    }

    private double CurrentTime()
        => Math.Clamp(_readout?.CurrentTime ?? 0d, 0d, Math.Max(Duration, 0d));

    private async Task OnScrub(ChangeEventArgs args)
    {
        if (!double.TryParse(
            args.Value?.ToString(),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out var time))
        {
            return;
        }

        await OnSeekRequested.InvokeAsync(Math.Clamp(time, 0d, Duration));
    }

    private static string Invariant(double value)
        => value.ToString("0.###", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _disposed = true;
        if (_subscribedChannel is not null)
        {
            _subscribedChannel.Updated -= HandleReadout;
        }
    }
}
