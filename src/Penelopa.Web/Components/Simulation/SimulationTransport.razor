@namespace Penelopa.Web.Components.Simulation
@using Penelopa.Core.Simulation
@using Penelopa.Web.Components
@using Penelopa.Web.Services

<div class="penelopa-simulation-transport" role="group" aria-label="Playback controls">
    <button type="button"
            class="penelopa-action is-small is-primary"
            disabled="@PrimaryDisabled"
            @onclick="PrimaryAsync">
        <PenelopaIcon Name="@PrimaryIcon" Size="14" />
        <span>@PrimaryLabel</span>
    </button>
    <button type="button"
            class="penelopa-action is-small"
            disabled="@(!CanStop)"
            @onclick="StopAsync">
        <PenelopaIcon Name="stop" Size="14" />
        <span>Stop</span>
    </button>
    <span class="penelopa-transport-divider" aria-hidden="true"></span>
    <button type="button"
            class="penelopa-action is-small"
            aria-label="Step back 1/60 second"
            title="Step back 1/60 second"
            disabled="@(!CanStep)"
            @onclick="StepBackAsync">-1/60</button>
    <button type="button"
            class="penelopa-action is-small"
            aria-label="Step forward 1/60 second"
            title="Step forward 1/60 second"
            disabled="@(!CanStep)"
            @onclick="StepForwardAsync">+1/60</button>
    <button type="button"
            class="penelopa-action is-small"
            aria-pressed="@(Loop ? "true" : "false")"
            disabled="@(!CanLoop)"
            @onclick="ToggleLoopAsync">
        <PenelopaIcon Name="loop" Size="14" />
        <span>Loop</span>
    </button>
    <span class="penelopa-transport-divider" aria-hidden="true"></span>
    <button type="button"
            class="penelopa-action is-small"
            disabled="@(!CanUndo)"
            @onclick="UndoAsync">
        <PenelopaIcon Name="undo" Size="14" />
        <span>Undo</span>
    </button>
    <button type="button"
            class="penelopa-action is-small"
            disabled="@(!CanRedo)"
            @onclick="RedoAsync">
        <PenelopaIcon Name="redo" Size="14" />
        <span>Redo</span>
    </button>
    <span class="penelopa-transport-divider" aria-hidden="true"></span>
    <span class="penelopa-simulation-status" aria-live="polite">@State</span>
    <span class="penelopa-transport-readout">
        <PenelopaIcon Name="clock" Size="12" />
        <SimulationTimeReadout Channel="@Channel" />
    </span>
</div>

@code {
    [Parameter]
    public SimulationState State { get; set; }

    [Parameter]
    public bool CanPlay { get; set; }

    [Parameter]
    public bool CanStop { get; set; }

    [Parameter]
    public bool CanLoop { get; set; }

    [Parameter]
    public bool Loop { get; set; }

    [Parameter]
    public bool CanStep { get; set; }

    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    [Parameter, EditorRequired]
    public SimulationReadoutChannel Channel { get; set; } = null!;

    [Parameter]
    public EventCallback OnPlay { get; set; }

    [Parameter]
    public EventCallback OnPause { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    [Parameter]
    public EventCallback OnToggleLoop { get; set; }

    [Parameter]
    public EventCallback OnStepBack { get; set; }

    [Parameter]
    public EventCallback OnStepForward { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnRedo { get; set; }

    private string PrimaryLabel => State switch
    {
        SimulationState.Playing => "Pause",
        SimulationState.Finished => "Replay",
        SimulationState.Paused or SimulationState.Preview => "Resume",
        _ => "Play",
    };

    private string PrimaryIcon
        => State == SimulationState.Playing ? "pause" : "play";

    private bool PrimaryDisabled
        => State != SimulationState.Playing && !CanPlay;

    private Task PrimaryAsync()
        => State == SimulationState.Playing
            ? OnPause.InvokeAsync()
            : OnPlay.InvokeAsync();

    private Task StopAsync() => OnStop.InvokeAsync();

    private Task StepBackAsync() => OnStepBack.InvokeAsync();

    private Task StepForwardAsync() => OnStepForward.InvokeAsync();

    private Task ToggleLoopAsync() => OnToggleLoop.InvokeAsync();

    private Task UndoAsync() => OnUndo.InvokeAsync();

    private Task RedoAsync() => OnRedo.InvokeAsync();
}
