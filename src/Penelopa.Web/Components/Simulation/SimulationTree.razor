@namespace Penelopa.Web.Components.Simulation
@using Astrea.Components.Tree
@using Microsoft.AspNetCore.Components.Web
@using Penelopa.Core.Primitives
@using Penelopa.Core.Simulation
@using Penelopa.Web.Components

<div class="penelopa-tree penelopa-simulation-tree">
    @if (Roots.Count == 0)
    {
        <div class="penelopa-empty-state">
            <PenelopaIcon Name="shapes" Size="22" />
            <p class="penelopa-tree-empty">No primitives yet. Return to the editor to add one or load the sample.</p>
        </div>
    }
    else
    {
        <Tree DataSource="_snapshot.Nodes"
              class="penelopa-tree-view"
              aria-label="Simulation primitives"
              SelectionMode="TreeSelectionMode.Single"
              SelectedIds="_selectedIds"
              SelectedIdsChanged="HandleSelectedIdsChanged"
              ShowLink="false"
              Indent="14"
              AutoDetectStructureChanges="false"
              UseInternalKeyboard="@OperatingSystem.IsBrowser()"
              OnKeyDown="HandleKeyDown">
            <IconTemplate Context="icon">
                <PenelopaIcon Name="@PrimitiveTreeSnapshot.IconFor(icon.Node)" Size="14" />
            </IconTemplate>
            <NodeTemplate Context="node">
                <span class="penelopa-tree-label">@node.Text</span>
                @if (HasAnimation(node))
                {
                    <span class="penelopa-simulation-badge"
                          aria-hidden="true"
                          title="Has animation">&#9679;</span>
                }
            </NodeTemplate>
        </Tree>
    }
</div>

@code {
    private PrimitiveTreeSnapshot _snapshot = PrimitiveTreeSnapshot.Empty;
    private IReadOnlyCollection<string> _selectedIds = Array.Empty<string>();
    private HashSet<Guid> _animatedIds = new();
    private IReadOnlyList<Primitive>? _lastRoots;
    private IReadOnlyList<SimulationTrack>? _lastTracks;

    [Parameter, EditorRequired]
    public IReadOnlyList<Primitive> Roots { get; set; } = Array.Empty<Primitive>();

    [Parameter]
    public Guid? SelectedId { get; set; }

    [Parameter]
    public IReadOnlyList<SimulationTrack> Tracks { get; set; } = Array.Empty<SimulationTrack>();

    [Parameter]
    public EventCallback<Primitive> OnSelect { get; set; }

    [Parameter]
    public EventCallback OnUndoConfig { get; set; }

    [Parameter]
    public EventCallback OnRedoConfig { get; set; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastRoots, Roots) || !ReferenceEquals(_lastTracks, Tracks))
        {
            _lastRoots = Roots;
            _lastTracks = Tracks;
            RebuildNodes();
        }

        _selectedIds = SelectedId is { } id
            ? new[] { id.ToString("N") }
            : Array.Empty<string>();
    }

    private void RebuildNodes()
    {
        _animatedIds = Tracks
            .Select(track => track.PrimitiveId)
            .ToHashSet();
        _snapshot = PrimitiveTreeSnapshot.Create(Roots, _animatedIds);
    }

    private bool HasAnimation(TreeNode node)
        => node.BindData is Primitive primitive
            && _animatedIds.Contains(primitive.Id);

    /// <summary>
    /// Astrea stops keydown propagation inside the tree, so the page-level
    /// simulation shortcuts are forwarded through its OnKeyDown hook.
    /// </summary>
    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (!args.CtrlKey && !args.MetaKey)
        {
            return;
        }

        var key = args.Key.ToLowerInvariant();
        if (!args.ShiftKey && key == "z")
        {
            await OnUndoConfig.InvokeAsync();
        }
        else if (key == "y" || (args.ShiftKey && key == "z"))
        {
            await OnRedoConfig.InvokeAsync();
        }
    }

    private async Task HandleSelectedIdsChanged(
        IReadOnlyCollection<string> selectedIds)
    {
        var selectedId = selectedIds.FirstOrDefault();
        if (selectedId is null
            || !_snapshot.ById.TryGetValue(selectedId, out var primitive))
        {
            return;
        }

        await OnSelect.InvokeAsync(primitive);
    }
}
