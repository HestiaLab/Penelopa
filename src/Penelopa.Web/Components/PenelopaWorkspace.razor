@namespace Penelopa.Web.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable

@* Penelopa workspace: Atlas dockable layout hosting the four editor panes.
   The layout tree is built programmatically (PenelopaWorkspaceDefinition) so
   this markup stays focused on content routing; the top toolbar and status
   bar are supplied through the host slots. *@

<section class="penelopa-shell"
         @ref="_shell"
         aria-label="Penelopa primitive alignment editor">
    <AtlasWorkspaceHost Workspace="@_workspace"
                        WorkspaceOwnership="WorkspaceOwnership.External"
                        EnableInteractions="true">
        <TopToolbarContent>
            <PenelopaTopToolbar />
        </TopToolbarContent>
        <StatusBarContent>
            <PenelopaStatusBar />
        </StatusBarContent>
        <ContentRoutes>
            <AtlasContentRoute Kind="@PenelopaContentKinds.Tools">
                <ChildContent Context="content">
                    <ToolPanel Content="content" />
                </ChildContent>
            </AtlasContentRoute>
            <AtlasContentRoute Kind="@PenelopaContentKinds.Tree">
                <ChildContent Context="content">
                    <PrimitiveTreePanel Content="content" />
                </ChildContent>
            </AtlasContentRoute>
            <AtlasContentRoute Kind="@PenelopaContentKinds.Canvas">
                <ChildContent Context="content">
                    <CanvasPanel Content="content" />
                </ChildContent>
            </AtlasContentRoute>
            <AtlasContentRoute Kind="@PenelopaContentKinds.Props">
                <ChildContent Context="content">
                    <PropertyPanel Content="content" />
                </ChildContent>
            </AtlasContentRoute>
        </ContentRoutes>
    </AtlasWorkspaceHost>
    <div class="penelopa-drop-overlay" aria-hidden="true">
        <div class="penelopa-drop-overlay-card">
            <strong>Drop to import</strong>
            <span>One .penelopa.json document</span>
        </div>
    </div>
    @if (_dropMessage is not null)
    {
        <div class="penelopa-drop-rejection" role="alert">
            <span>@_dropMessage</span>
            <button type="button"
                    class="penelopa-tool-button"
                    aria-label="Dismiss import message"
                    @onclick="DismissDropMessage">&#215;</button>
        </div>
    }
</section>

@code {
    private IAtlasWorkspace? _workspace;
    private ElementReference _shell;
    private IJSObjectReference? _dropHandle;
    private DotNetObjectReference<PenelopaWorkspace>? _dropRef;
    private string? _dropMessage;
    private bool _disposed;

    [Inject]
    private IAtlasWorkspaceFactory Factory { get; set; } = null!;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        var result = Factory.Create(PenelopaWorkspaceDefinition.Create("penelopa"));
        if (!result.Succeeded || result.Value is null)
        {
            throw new InvalidOperationException(
                result.Error?.DiagnosticId ?? "Penelopa workspace initialization failed.");
        }

        _workspace = result.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _dropRef = DotNetObjectReference.Create(this);
            _dropHandle = await JS.InvokeAsync<IJSObjectReference>(
                "penelopa.attachFileDrop",
                _shell,
                _dropRef);
        }
        catch (Exception ex) when (ex is JSException
            or JSDisconnectedException
            or InvalidOperationException)
        {
            // 拖放不可用时仍保留 Tools 面板的 Import file 按钮。
            Console.Error.WriteLine($"[Penelopa] PenelopaWorkspace file drop failed: {ex}");
            _dropRef?.Dispose();
            _dropRef = null;
        }
    }

    [JSInvokable]
    public void OnFileDropRejected(string message)
    {
        if (_disposed)
        {
            return;
        }

        _dropMessage = message;
        StateHasChanged();
    }

    private void DismissDropMessage()
    {
        _dropMessage = null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_dropHandle is not null)
        {
            try
            {
                await _dropHandle.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                // 页面卸载时 JS 侧已不可达
            }

            _dropHandle = null;
        }

        _dropRef?.Dispose();
        _dropRef = null;

        if (_workspace is null)
        {
            return;
        }

        await _workspace.DisposeAsync();
        _workspace = null;
    }
}
