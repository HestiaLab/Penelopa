@namespace Penelopa.Web.Components

<svg class="penelopa-icon @CssClass"
     width="@Size"
     height="@Size"
     viewBox="0 0 16 16"
     fill="none"
     stroke="currentColor"
     stroke-width="1.5"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @switch (Name)
    {
        case "shapes":
            <circle cx="5.5" cy="5.25" r="2.5" />
            <rect x="9" y="9" width="4.5" height="4.5" rx="0.75" />
            <path d="M11.5 2.5 14.5 7.5H8.5z" />
            break;
        case "circle":
            <circle cx="8" cy="8" r="5" />
            break;
        case "square":
            <rect x="3" y="3" width="10" height="10" rx="1.25" />
            break;
        case "triangle":
            <path d="M8 2.75 14 13.25H2z" />
            break;
        case "container":
            <rect x="2.75" y="2.75" width="10.5" height="10.5" rx="1" stroke-dasharray="2 1.6" />
            <rect x="5.5" y="5.5" width="5" height="5" rx="0.5" />
            break;
        case "move":
            <path d="M8 2.25v11.5M2.25 8h11.5" />
            <path d="M6.25 4 8 2.25 9.75 4M6.25 12 8 13.75 9.75 12M4 6.25 2.25 8 4 9.75M12 6.25 13.75 8 12 9.75" />
            break;
        case "rotate":
            <path d="M13 8a5 5 0 1 1-1.6-3.7" />
            <path d="M13 2.75v3h-3" />
            <circle cx="8" cy="8" r="1.25" />
            break;
        case "flip":
            <path d="M8 2v12" stroke-dasharray="1.5 1.5" />
            <path d="M6 4.75 2.25 8 6 11.25zM10 4.75 13.75 8 10 11.25z" />
            break;
        case "save":
            <path d="M3.5 2.5h7l3 3v8h-10z" />
            <path d="M5.5 2.5v3.5h4V2.5" />
            <path d="M5.5 9h5v4.5h-5z" />
            break;
        case "folder":
            <path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h2.3l1.2 1.5h4.5A1.5 1.5 0 0 1 13 6v5a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 2 11z" />
            break;
        case "folder-open":
            <path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h2.3l1.2 1.5h4.5A1.5 1.5 0 0 1 13 6v1.25" />
            <path d="M2.25 7.25h11.5L12.4 13H3.1z" />
            break;
        case "upload":
            <path d="M8 10.5V2.5" />
            <path d="M4.75 5.75 8 2.5l3.25 3.25" />
            <path d="M3 10.5V13h10v-2.5" />
            break;
        case "download":
            <path d="M8 2.5v8" />
            <path d="M4.75 7.25 8 10.5l3.25-3.25" />
            <path d="M3 11v2h10v-2" />
            break;
        case "trash":
            <path d="M2.75 4.5h10.5" />
            <path d="M6 4.5V3h4v1.5" />
            <path d="m4.5 4.5.6 8.5h5.8l.6-8.5" />
            <path d="M6.75 7v4M9.25 7v4" />
            break;
        case "group":
            <rect x="2.5" y="2.5" width="11" height="11" rx="1" stroke-dasharray="2 1.6" />
            <rect x="4.75" y="4.75" width="3.5" height="3.5" rx="0.5" />
            <rect x="7.75" y="7.75" width="3.5" height="3.5" rx="0.5" />
            break;
        case "ungroup":
            <rect x="2.25" y="2.25" width="4.5" height="4.5" rx="0.75" />
            <rect x="9.25" y="9.25" width="4.5" height="4.5" rx="0.75" />
            <path d="M8 4.5h3.25M13.5 2.25 11.25 4.5l2.25 2.25" />
            <path d="M8 11.5H4.75M2.5 13.75 4.75 11.5 2.5 9.25" />
            break;
        case "align-left":
            <path d="M3 2.5v11" />
            <rect x="4.75" y="4" width="7" height="2.5" rx="0.5" />
            <rect x="4.75" y="9.5" width="4.5" height="2.5" rx="0.5" />
            break;
        case "align-hcenter":
            <path d="M8 2.5v11" />
            <rect x="3.75" y="4" width="8.5" height="2.5" rx="0.5" />
            <rect x="5.5" y="9.5" width="5" height="2.5" rx="0.5" />
            break;
        case "align-right":
            <path d="M13 2.5v11" />
            <rect x="4.25" y="4" width="7" height="2.5" rx="0.5" />
            <rect x="6.75" y="9.5" width="4.5" height="2.5" rx="0.5" />
            break;
        case "align-top":
            <path d="M2.5 3h11" />
            <rect x="4" y="4.75" width="2.5" height="7" rx="0.5" />
            <rect x="9.5" y="4.75" width="2.5" height="4.5" rx="0.5" />
            break;
        case "align-vcenter":
            <path d="M2.5 8h11" />
            <rect x="4" y="3.75" width="2.5" height="8.5" rx="0.5" />
            <rect x="9.5" y="5.5" width="2.5" height="5" rx="0.5" />
            break;
        case "align-bottom":
            <path d="M2.5 13h11" />
            <rect x="4" y="4.25" width="2.5" height="7" rx="0.5" />
            <rect x="9.5" y="6.75" width="2.5" height="4.5" rx="0.5" />
            break;
        case "fit":
            <path d="M3 6V3.5h2.5M13 6V3.5h-2.5M3 10v2.5h2.5M13 10v2.5h-2.5" />
            break;
        case "play":
            <path d="M5.25 3.25v9.5L12.5 8z" fill="currentColor" stroke="none" />
            break;
        case "pause":
            <rect x="4" y="3.25" width="3" height="9.5" rx="0.5" fill="currentColor" stroke="none" />
            <rect x="9" y="3.25" width="3" height="9.5" rx="0.5" fill="currentColor" stroke="none" />
            break;
        case "stop":
            <rect x="4" y="4" width="8" height="8" rx="1" fill="currentColor" stroke="none" />
            break;
        case "step-back":
            <path d="M4.5 3.5v9" />
            <path d="M12 3.5 6 8l6 4.5z" fill="currentColor" stroke="none" />
            break;
        case "step-forward":
            <path d="M11.5 3.5v9" />
            <path d="M4 3.5 10 8l-6 4.5z" fill="currentColor" stroke="none" />
            break;
        case "loop":
            <path d="M13 8a5 5 0 1 1-1.5-3.55" />
            <path d="M13 2.75v2.9h-2.9" />
            break;
        case "undo":
            <path d="M3 7h6.5a3.5 3.5 0 0 1 0 7H7" />
            <path d="M6 4 3 7l3 3" />
            break;
        case "redo":
            <path d="M13 7H6.5a3.5 3.5 0 0 0 0 7H9" />
            <path d="m10 4 3 3-3 3" />
            break;
        case "back":
            <path d="M13 8H3.5" />
            <path d="M7 4.5 3.5 8 7 11.5" />
            break;
        case "file":
            <path d="M4 2h4.5L12 5.5V14H4z" />
            <path d="M8.5 2v3.5H12" />
            break;
        case "clock":
            <circle cx="8" cy="8" r="5.25" />
            <path d="M8 4.75V8l2.25 1.5" />
            break;
        case "signal":
            <path d="M3 3v5.25A2.75 2.75 0 0 0 5.75 11H13" />
            <path d="m10 8 3 3-3 3" />
            break;
        case "sliders":
            <path d="M3 4h10M3 8h10M3 12h10" />
            <circle cx="6" cy="4" r="1.25" fill="var(--penelopa-surface)" />
            <circle cx="10" cy="8" r="1.25" fill="var(--penelopa-surface)" />
            <circle cx="6" cy="12" r="1.25" fill="var(--penelopa-surface)" />
            break;
        case "chevron-right":
            <path d="m6 4 4 4-4 4" />
            break;
        case "chevron-down":
            <path d="m4 6 4 4 4-4" />
            break;
        case "close":
            <path d="m4 4 8 8M12 4 4 12" />
            break;
        case "error":
            <circle cx="8" cy="8" r="5.5" />
            <path d="M8 5v3.5M8 11h.01" />
            break;
        case "warning":
            <path d="M8 2.5 14 13H2z" />
            <path d="M8 6.25v3M8 11.25h.01" />
            break;
        case "check":
            <circle cx="8" cy="8" r="5.5" />
            <path d="m5.5 8 1.75 1.75L10.75 6.5" />
            break;
        case "keyframe":
            <path d="M8 2.5 13.5 8 8 13.5 2.5 8z" />
            break;
        default:
            <circle cx="8" cy="8" r="5.5" />
            <path d="M8 5v3.5M8 11h.01" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 16;

    [Parameter]
    public string? CssClass { get; set; }
}
