<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Penelopa.Web</AssemblyName>
    <!-- 项目、程序集与根命名空间统一采用 Penelopa.Web。 -->
    <RootNamespace>Penelopa.Web</RootNamespace>
    <!-- Force the WASM native link (libSkiaSharp.a) so VS and CLI builds
         produce the same dotnet.wasm. Without this, VS's incremental build
         can skip the emscripten link and serve a runtime-pack dotnet.wasm
         that lacks libSkiaSharp (DllNotFoundException at runtime). -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Astrea.Components" />
    <PackageReference Include="Atlas.Blazor" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.Views.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Penelopa.Core\Penelopa.Core.csproj" />
    <ProjectReference Include="..\Penelopa.Rendering\Penelopa.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Penelopa.Web.Tests" />
  </ItemGroup>

  <!-- Compile the TypeScript pointer layer when the local npm toolchain is
       installed. ts/penelopa.ts is the source of truth and the generated
       wwwroot/js/penelopa.js is committed, so a clean checkout without Node
       builds and runs from the committed JS. CI runs npm ci first, which makes
       this target compile and the drift check fail if the committed JS is stale. -->
  <PropertyGroup>
    <TypeScriptCompilerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../node_modules/typescript/bin/tsc'))</TypeScriptCompilerPath>
  </PropertyGroup>
  <Target Name="BuildTypeScript" BeforeTargets="Build"
          Condition="Exists('$(TypeScriptCompilerPath)') and Exists('$(MSBuildThisFileDirectory)../../package.json')">
    <Exec Command="npm run build:js" WorkingDirectory="$(MSBuildThisFileDirectory)../.."
          StandardOutputImportance="normal" />
  </Target>

</Project>
